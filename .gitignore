# Local build output, compiler downloads, caches, and release packages
/build/
/Releases/
/cmake-build-*/
.zig-cache/
zig-cache/
zig-out/

# Local development support, kept on disk but not published
/src/docs/
/src/scripts/
/src/tests/

# CMake files generated by an in-source build
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
CTestTestfile.cmake
Testing/
compile_commands.json
install_manifest.txt

# Compiled binaries and debug symbols (publish DLLs through Releases)
*.dll
*.exe
*.lib
*.exp
*.obj
*.o
*.pdb
*.ilk
*.idb
*.pch
*.ipch
*.res

# Local IDE state and generated Visual Studio output
.vs/
/Debug/
/Release/
/Win32/
/x64/
*.user
*.suo
*.userosscache
*.sln.docstates

# Archives, temporary output, and local operating-system files
*.zip
*.7z
*.log
*.tmp
*.temp
.DS_Store
Thumbs.db
Desktop.ini
